# Argon2id hash only. Never commit the original access code.
DOCUMENTS_ACCESS_PASSWORD_HASH=
SESSION_SECRET=
# Private Base32 key from your authenticator setup; never NEXT_PUBLIC_*.
AUTH_TOTP_SECRET=

# External Neon PostgreSQL URL. All secrets belong on Render only.
DATABASE_URL=
# Independent Base64/Base64URL keys (32 random bytes each).
DATA_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=
# Cloudflare R2 S3 credentials, backend only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional managed PAdES signing service.
PDF_SIGNING_SERVICE_URL=
PDF_SIGNING_SERVICE_TOKEN=
